package templates

templ SearchInterface(authenticated bool) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>What-A-Git-Year - Home</title>
		<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.7/dist/htmx.min.js"></script>
		<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
		<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
	</head>
	<body class="min-h-screen bg-base-100 flex flex-col">
		@NavBar(authenticated)
		
		<div class="flex-1 flex items-center justify-center p-4">
			<div class="w-full max-w-2xl">
				<div class="text-center mb-12">
					<h1 class="text-6xl font-bold mb-4 tracking-tight">
						<span class="text-base-content">What</span>
						<span class="text-primary">-A-</span>
						<span class="text-base-content">Git</span>
						<span class="text-primary">-</span>
						<span class="text-base-content">Year</span>
					</h1>
					<p class="text-base-content/60 text-lg">Discover the treasures in your GitHub journey!</p>
				</div>
				<div class="flex flex-col items-center mb-8">
					<img src="/static/search.png" class="w-[50%] h-[50%]"/>
				</div>
				<!-- Search Form -->
				<div class="card bg-base-200 shadow-2xl">
					<div class="card-body p-8">
						<form id="search-form" class="space-y-6">
							<!-- Search Type Toggle -->
							<div class="flex justify-center gap-2">
								<input
									type="radio"
									name="search-type"
									value="user"
									id="type-user"
									class="radio radio-primary radio-sm"
									checked
								/>
								<label for="type-user" class="label-text cursor-pointer mr-6">User</label>
								if authenticated {
									<input
										type="radio"
										name="search-type"
										value="org"
										id="type-org"
										class="radio radio-primary radio-sm"
									/>
									<label for="type-org" class="label-text cursor-pointer">Organization</label>
								} else {
									<input
										type="radio"
										name="search-type"
										value="org"
										id="type-org"
										class="radio radio-primary radio-sm"
										disabled
									/>
									<label for="type-org" class="label-text cursor-pointer text-gray-500">Organization (log in for this feature)</label>
								}
							</div>
							<div class="form-control">
								<div class="join w-full">
									<input
										type="text"
										id="search-input"
										placeholder="Enter GitHub username or organization..."
										class="input input-bordered input-lg join-item w-full focus:outline-offset-0"
										required
									/>
									<button
										type="submit"
										class="btn btn-primary btn-lg join-item px-8"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
										</svg>
									</button>
								</div>
							</div>
							<!-- Popular Examples -->
							<div class="text-center">
								<p class="text-sm text-base-content/40 mb-2">Try:</p>
								<div class="flex flex-wrap justify-center gap-2">
									<button
										type="button"
										class="badge badge-outline badge-lg cursor-pointer hover:badge-primary transition-colors"
										onclick="document.getElementById('search-input').value = 'torvalds'"
									>
										torvalds
									</button>
									<button
										type="button"
										class="badge badge-outline badge-lg cursor-pointer hover:badge-primary transition-colors"
										onclick="document.getElementById('search-input').value = 'google'"
									>
										google
									</button>
									<button
										type="button"
										class="badge badge-outline badge-lg cursor-pointer hover:badge-primary transition-colors"
										onclick="document.getElementById('search-input').value = 'huggingface'"
									>
										huggingface
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
		
		@Footer()
	</body>
}